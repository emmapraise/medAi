{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "includeFiles": "{vercel_models/**,frontend/dist/**}",
      "excludeFiles": "{frontend/src/**,frontend/node_modules/**,public/**,tests/**,eval/**,docs/**,scripts/**,dataset/**,qdrant_storage/**,models/**,*.ipynb}"
    }
  }
}
